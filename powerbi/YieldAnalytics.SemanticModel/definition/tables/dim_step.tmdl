table dim_step

	column step_id
		dataType: int64
		summarizeBy: none
		sourceColumn: step_id

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	column area
		dataType: string
		summarizeBy: none
		sourceColumn: area

	column step_type
		dataType: string
		summarizeBy: none
		sourceColumn: step_type

	column param_name
		dataType: string
		summarizeBy: none
		sourceColumn: param_name

	column param_unit
		dataType: string
		summarizeBy: none
		sourceColumn: param_unit

	column lsl
		dataType: double
		summarizeBy: none
		sourceColumn: lsl

	column target
		dataType: double
		summarizeBy: none
		sourceColumn: target

	column usl
		dataType: double
		summarizeBy: none
		sourceColumn: usl

	partition dim_step = m
		mode: import
		source =
				let
				    Source = #"Load Parquet"("dim_step")
				in
				    Source
