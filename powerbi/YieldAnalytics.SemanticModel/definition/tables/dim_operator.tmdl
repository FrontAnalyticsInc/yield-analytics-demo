table dim_operator

	column operator_id
		dataType: string
		summarizeBy: none
		sourceColumn: operator_id

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	column shift
		dataType: string
		summarizeBy: none
		sourceColumn: shift

	column hire_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: hire_date
		formatString: yyyy-mm-dd

	partition dim_operator = m
		mode: import
		source =
				let
				    Source = #"Load Parquet"("dim_operator")
				in
				    Source
