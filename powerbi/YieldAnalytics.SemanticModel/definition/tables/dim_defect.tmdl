table dim_defect

	column defect_code
		dataType: string
		summarizeBy: none
		sourceColumn: defect_code

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	partition dim_defect = m
		mode: import
		source =
				let
				    Source = #"Load Parquet"("dim_defect")
				in
				    Source
