# Copy to .env. SQL Server needs 8+ chars with upper, lower, digit and symbol.
DB_PASSWORD=
PUBLIC_URL=http://localhost:8000
# Power BI reads Parquet from <PUBLIC_URL>/exports/<table>.parquet?key=<EXPORT_KEY> (unset = feed disabled)
EXPORT_KEY=
# Optional: Azure Blob target for the Power BI Parquet feed
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=yield
# walden only: written by scripts/cf-tunnel.sh create
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_ID=
